    }
   ],
   "source": [
    "MODEL_ID = \"microsoft/deberta-v3-small\"   # Hub name; the local copy is found by its last path component\n",
    "MAX_LEN = 64            # anchor + target + context fit easily within 64 tokens\n",
    "EPOCHS = 3\n",
    "LR = 2e-5\n",
    "BATCH_SIZE = 32\n",
    "VAL_FRACTION = 0.2      # share of *anchors* (not rows) held out for validation\n",
    "OUT_DIR = \"/kaggle/working\" if os.path.isdir(\"/kaggle/working\") else \".\"\n",
    "os.makedirs(OUT_DIR, exist_ok=True)\n",
    "\n",
    "\n",
    "def find_one(pattern):\n",
    "    \"\"\"Return the directory of the first file under /kaggle/input, local directories, or kagglehub cache.\"\"\"\n",
    "    candidates = (\n",
    "        glob.glob(f\"/kaggle/input/**/{pattern}\", recursive=True)\n",
    "        + glob.glob(f\"**/{pattern}\", recursive=True)\n",
    "        + glob.glob(pattern)\n",
    "        + glob.glob(f\"./{pattern}\")\n",
    "        + glob.glob(os.path.expanduser(f\"~/.cache/kagglehub/**/{pattern}\"), recursive=True)\n",
    "    )\n",
    "    if candidates:\n",
    "        d = os.path.dirname(candidates[0])\n",
    "        return d if d else \".\"\n",
    "    return None\n",
    "\n",
    "\n",
    "DATA_DIR = find_one(\"us-patent-phrase-to-phrase-matching/train.csv\") or find_one(\"train.csv\")\n",
    "if not DATA_DIR:\n",
    "    # Try kagglehub download if available\n",
    "    try:\n",
    "        import kagglehub\n",
    "        path_kh = kagglehub.competition_download(\"us-patent-phrase-to-phrase-matching\")\n",
    "        if os.path.isfile(os.path.join(path_kh, \"train.csv\")):\n",
    "            DATA_DIR = path_kh\n",
    "    except Exception:\n",
    "        pass\n",
    "\n",
    "MODEL_PATH = find_one(f\"{MODEL_ID.split('/')[-1]}/config.json\") or MODEL_ID\n",
    "print(\"data:\", DATA_DIR)\n",
    "print(\"model:\", MODEL_PATH, \"(local)\" if MODEL_PATH != MODEL_ID else \"(Hub download: needs internet)\")\n"
   ]
  },
